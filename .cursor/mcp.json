{
  "mcpServers": {
    "woocommerce": {
      "url": "https://vitalsuplementos.com.mx/wp-json/woocommerce/mcp",
      "headers": {
        "X-MCP-API-Key": "${env:WOO_key}:${env:WOO_secret}"
      }
    },
    "woocommerce-stdio": {
      "type": "stdio",
      "command": "node",
      "args": ["${workspaceFolder}/scripts/woo-mcp-local.mjs"],
      "envFile": "${workspaceFolder}/.env"
    },
    "wordpress.com": {
      "url": "https://public-api.wordpress.com/wpcom/v2/mcp/v1"
    }
  }
}
