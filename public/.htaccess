# The storefront is a single-page app: only index.html exists on disk, so a
# direct hit on /tienda/producto/creatina would 404 before React ever loads.
# Hand any path that is not a real file back to index.html and let the client
# router resolve it. Real files — assets, product photos — are served normally.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /tienda/

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule . /tienda/index.html [L]
</IfModule>
